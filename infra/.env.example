# Copy this file to .env and replace every "changeme" value.
#   cp infra/.env.example infra/.env
# .env is gitignored and must never be committed.

NODE_ENV=development

# API
API_PORT=4000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

# MongoDB
# Hostname is the compose service name, not localhost.
MONGO_ROOT_USER=codeguard
MONGO_ROOT_PASSWORD=changeme_mongo_password
MONGO_DB=codeguard
MONGO_URI=mongodb://codeguard:changeme_mongo_password@mongo:27017/codeguard?authSource=admin

# Redis — job queue for detection work
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO — S3-compatible object storage for submitted source files
MINIO_ROOT_USER=codeguard
MINIO_ROOT_PASSWORD=changeme_minio_password
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=submissions

# JWT
# Generate real 64-char hex values. The two secrets must differ.
JWT_ACCESS_SECRET=changeme_generate_64_random_hex_chars
JWT_REFRESH_SECRET=changeme_generate_a_different_64_hex_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Python detection service
DETECTOR_URL=http://detector:8000
DETECTOR_TIMEOUT_MS=30000

# Upload limits
MAX_UPLOAD_BYTES=1048576
ALLOWED_EXTENSIONS=.py,.java
