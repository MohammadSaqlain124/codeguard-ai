# Copy this file to .env and replace every "changeme" value.
#   cp infra/.env.example infra/.env
# .env is gitignored and must never be committed. This file is committed, so
# nothing real belongs in it: no passwords, no connection strings you actually
# use, not even a dead one.

NODE_ENV=development

# API
API_PORT=4000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

# MongoDB
# Hostname is the compose service name, not localhost.
MONGO_ROOT_USER=codeguard
MONGO_ROOT_PASSWORD=changeme_mongo_password
MONGO_DB=codeguard
MONGO_URI=mongodb://codeguard:changeme_mongo_password@mongo:27017/codeguard?authSource=admin

# Redis - job queue for detection work
REDIS_HOST=redis
REDIS_PORT=6379
# Local compose Redis has no password and no TLS, so both of these stay empty
# and false. A hosted Redis needs them; see the deployment section below.
REDIS_PASSWORD=
REDIS_TLS=false

# MinIO - S3-compatible object storage for submitted source files
MINIO_ROOT_USER=codeguard
MINIO_ROOT_PASSWORD=changeme_minio_password
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=submissions

# JWT
# Generate real 64-char hex values. The two secrets must differ.
JWT_ACCESS_SECRET=changeme_generate_64_random_hex_chars
JWT_REFRESH_SECRET=changeme_generate_a_different_64_hex_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Python detection service
DETECTOR_URL=http://detector:8000
DETECTOR_TIMEOUT_MS=30000
# Shared secret the api sends as x-detector-token on every detector call.
# Must be at least 32 characters and must match the detector's own copy.
DETECTOR_TOKEN=changeme_generate_32_or_more_chars

# Upload limits
MAX_UPLOAD_BYTES=1048576
ALLOWED_EXTENSIONS=.py,.java


# ---------------------------------------------------------------------------
# Running the api outside Docker, against the compose services
# ---------------------------------------------------------------------------
# The hostnames above are compose service names, which only resolve from
# inside the compose network. When you run `npm run dev` on the host instead,
# every one of them has to become localhost. Override these four at the bottom
# of your own .env, where a later key wins:
#
#   MONGO_URI=mongodb://codeguard:<your real mongo password>@localhost:27017/codeguard?authSource=admin
#   REDIS_HOST=localhost
#   MINIO_ENDPOINT=localhost
#   DETECTOR_URL=http://localhost:8000
#
# Those lines belong in .env, never here.


# ---------------------------------------------------------------------------
# Deploying to a host
# ---------------------------------------------------------------------------
# What changes, and nothing else does:
#
#   NODE_ENV=production
#   CORS_ORIGIN       the deployed web origin, with no trailing slash
#   API_PORT          whatever port the host tells the process to bind
#   MONGO_URI         the mongodb+srv:// string from the provider
#   REDIS_HOST/PORT   the provider's host and port
#   REDIS_PASSWORD    the provider's password
#   REDIS_TLS=true    hosted Redis is almost always TLS only
#   MINIO_*           the S3-compatible endpoint, port 443, MINIO_USE_SSL=true
#
# The two JWT secrets and DETECTOR_TOKEN must be generated fresh for the
# deployment. Reusing a development secret in production means a token minted
# on a laptop is valid against the live system.
